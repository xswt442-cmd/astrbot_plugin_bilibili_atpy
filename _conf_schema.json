{
  "enabled": {
    "description": "启用后台定时",
    "type": "bool",
    "default": true,
    "hint": "关掉不自动跑，/atpy 现在 仍能手动触发。"
  },
  "sessdata": {
    "description": "B站 SESSDATA",
    "type": "string",
    "default": "",
    "hint": "登录后 F12 → Application → Cookies 复制。建议用小号。"
  },
  "bili_jct": {
    "description": "B站 bili_jct",
    "type": "string",
    "default": "",
    "hint": "同一 Cookie 列表里的 bili_jct，发评论时当 csrf。要和 SESSDATA 同账号。"
  },
  "friends": {
    "description": "@ 谁",
    "type": "string",
    "default": "",
    "hint": "B站昵称，逗号分隔。必须一字不差，拼错就只是纯文本。"
  },
  "notify_umo": {
    "description": "通知会话",
    "type": "string",
    "default": "",
    "hint": "发完往哪个会话说一声。在群里发 /atpy UMO 取整串，留空不通知。"
  },
  "rounds_min": {
    "description": "每天最少几条",
    "type": "int",
    "default": 1,
    "hint": "和上限一起决定当天的随机条数。"
  },
  "rounds_max": {
    "description": "每天最多几条",
    "type": "int",
    "default": 1,
    "hint": "默认一条。带 @ 的评论发多了容易被风控。"
  },
  "active_start_hour": {
    "description": "活跃时段起始（整点）",
    "type": "int",
    "default": 9,
    "hint": "0-23，夜里不跑，更像真人。"
  },
  "active_end_hour": {
    "description": "活跃时段结束（整点）",
    "type": "int",
    "default": 23,
    "hint": "0-23，须晚于起始。"
  },
  "min_play": {
    "description": "播放量下限",
    "type": "int",
    "default": 10000,
    "hint": "低于这个数多半没人看，评论区也是空的。"
  },
  "max_play": {
    "description": "播放量上限",
    "type": "int",
    "default": 5000000,
    "hint": "高于这个数是全网刷过的烂梗。"
  },
  "max_days_old": {
    "description": "只要几天内发布的",
    "type": "int",
    "default": 0,
    "hint": "0 表示不限。"
  },
  "keywords": {
    "description": "自定义关键词",
    "type": "string",
    "default": "",
    "hint": "逗号分隔。填了就只用这些词，不再按内置五类轮转。"
  },
  "provider_id": {
    "description": "写锐评用的模型",
    "type": "string",
    "default": "",
    "hint": "填 AstrBot 里的模型 ID，留空用第一个已加载的。"
  },
  "model_timeout_seconds": {
    "description": "模型超时（秒）",
    "type": "int",
    "default": 60,
    "hint": "超时这轮跳过，不重试。"
  },
  "dry_run": {
    "description": "预览模式",
    "type": "bool",
    "default": false,
    "hint": "只选片和写评，不真发。第一次部署建议先开一天。"
  }
}
